#include <kernel.hmm>
#include <util.hmm>
#include <AudioDecoder.hmm>
#include <MP3Player.hmm>

#include "lcd.hmm"
#include "spi.hmm"
#include "mp3Files.hmm"
#include "shellProc.hmm"
#include "Key.hmm"

void waitToReopenMP3Player() {
  cls();
  locateXY(0, 1); putStr("MP3Player closed");
  locateXY(0, 3); putStr("BACK return:OK");
  locateXY(0, 6); putStr("ENT:Open again");
#ifdef DEBUG
  printF("MP3Player returned to caller\n");
#endif
  for (;;) {
    key_step();
    if (key_pressed(KEY_ENTER)!=0) return;
    sleep(10);
  }
}

public void shellMain() {
  spiResetLcd();
  spiResetMp3();
  mp3FilesInit();
  setVolume(40);

  testMP3Player();

#ifdef DEBUG
  printF("--- MP3Player hardware test ---\n");
  printF("List: SW1 up SW5 down SW6 play\n");
  printF("Info: SW1/SW5 item SW2/SW3 value\n");
  printF("Volume and speed change by 1\n");
  printF("Repeat and Shuffle are exclusive\n");
  printF("Wait for natural end to verify modes\n");
#endif

  for (;;) {
    showMP3Player(MP3PLAYER_LIST);
    waitToReopenMP3Player();
  }
}
