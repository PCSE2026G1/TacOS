#include <kernel.hmm>
#include <util.hmm>
#include <Clock.hmm>
#include <AudioDecoder.hmm>
#include <ClockViewer.hmm>

#include "lcd.hmm"
#include "spi.hmm"
#include "mp3Files.hmm"
#include "shellProc.hmm"

Time clockViewerInitialTime = {2026, 12, 31, 23, 59, 50};

public void shellMain() {
  char[] alarmFile;

  spiResetLcd();
  spiResetMp3();
  mp3FilesInit();
  setVolume(40);

  alarmFile = mp3FilesGetPath(1);
  if (alarmFile!=null) setFile(alarmFile);
  setTime(clockViewerInitialTime);

  testClockViewer();

#ifdef DEBUG
  printF("--- ClockViewer hardware test ---\n");
  if (alarmFile!=null) printF("alarm file=%s\n", alarmFile);
  else printF("alarm file:null\n");
  printF("Initial time=2026/12/31 23:59:50\n");
  printF("Set Alarm 00:00 to test after 10 sec\n");
#endif

  showClockViewer();
}
