#include <kernel.hmm>
#include <util.hmm>
#include "list.hmm"
#include "lcd.hmm"

#define SW1 0x20
#define SW2 0x10
#define SW3 0x08
#define SW4 0x04
#define SW5 0x02
#define SW6 0x01
#define SWS 0x3f 

int sw0 = 0x00;
int sw1 = 0x00;    

int readSw() {
  int sw = ~in(0x18) & SWS;                         // スイッチを読み正論理に変換
  int swd = sw & sw0;                               // デバウンス
  int sw2 = (sw1 ^ swd) & swd;                      // 今回，新たに押されたSW
  sw0 = sw;
  sw1 = swd;
  return sw2;
}

int swToNum(int sw) {
  int num = -1;
  if ((sw & SW6)!=0) {                              // 6 番のスイッチが押された
    num = 6;
  } else if ((sw & SW5)!=0) {                       // 5 番のスイッチが押された
    num = 5;
  } else if ((sw & SW4)!=0) {                       // 4 番のスイッチが押された
    num = 4;
  } else if ((sw & SW3)!=0) {                       // 3 番のスイッチが押された
    num = 3;
  } else if ((sw & SW2)!=0) {                       // 2 番のスイッチが押された
    num = 2;
  } else if ((sw & SW1)!=0) {                       // 1 番のスイッチが押された
    num = 1;
  }
  return num;
}

public int select(char[] title, char[][] fnames, int size) {

    int fileCount = 6;  //ファイルを表示できる数6個
    lcd_draw_string(0,0,title);  //1行目にタイトル
    lcd_draw_string(0,1,"");     //2行目に空白

    int loop = fileCount;
    if(size < fileCount){
        loop = size;
    }
    for (int i = 0; i < loop; i=i+1) {
      lcd_draw_string(0, i+2, fname[i]);
    }


    int cursor = 0;
    for (;;) {
        int sw = readSw();
        int num = swToNum(sw);
        int start = 0; //描画開始位置

        if (num == 5) { // 下
            if (cursor < size - 1) {
                cursor = cursor + 1;

                //cursorが、描画開始位置から6個を越えたらカーソルが画面外なので描画位置(start)を++
                if (cursor >= start + fileCount) {
                    start = start + 1;
                }
            }
        }
        else if (num == 1) { // 上
            if (cursor > 0) {
                cursor = cursor - 1;

                //cursorが、描画開始位置の前に来たら描画開始位置(start)を--
                if (cursor < start) {
                    start = start - 1;
                }
            }
        }

        //もし画面サイズstartから6個が、サイズより大きくなったら
        if (start + fileCount > size) {
            start = size - fileCount;
        }

        for (int i = 0; i < loop; i=i+1) {
            int index = start + i;

            lcd_draw_string(0, i+2, fnames[index]);
        }
    }
    return cursor;
}