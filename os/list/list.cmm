#include "list.hmm"
#include "Lcd.hmm"

public int select(char[] title, char[][] array, int size) {

    int fileCount = 6;  //ファイルを表示できる数6個
    drawString(0,0,title);  //1行目にタイトル
    drawString(0,1,"");     //2行目に空白

    int loop = fileCount;
    if(size < fileCount){
        loop = size;
    }
    for (int i = 0; i < loop; i++) {
        drawString(0, i+2, array[i]);
    }


    int cursor = 0;
    for (;;) {
        int sw = readSw();
        int num = swToNum(sw);
        int start = 0; //描画開始位置

        if (num == 5) { // 下
            if (cursor < size - 1) {
                cursor++;

                //cursorが、描画開始位置から6個を越えたらカーソルが画面外なので描画位置(start)を++
                if (cursor >= start + fileCount) {
                    start++;
                }
            }
        }
        else if (num == 1) { // 上
            if (cursor > 0) {
                cursor--;

                //cursorが、描画開始位置の前に来たら描画開始位置(start)を--
                if (cursor < start) {
                    start--;
                }
            }
        }

        //もし画面サイズstartから6個が、サイズより大きくなったら
        if (start + fileCount > size) {
            start = size - fileCount;
        }

        for (int i = 0; i < loop; i++) {
            int index = start + i;

            drawString(0, i+2, array[index]);
        }
    }
    return cursor
}

int swToNum(int sw) {
  int num = -1;
  if ((sw & SW6)!=0) {                              // 6 番のスイッチが押された
    num = 6;
  } else if ((sw & SW5)!=0) {                       // 5 番のスイッチが押された
    num = 5;
  } else if ((sw & SW4)!=0) {                       // 4 番のスイッチが押された
    num = 4;
  } else if ((sw & SW3)!=0) {                       // 3 番のスイッチが押された
    num = 3;
  } else if ((sw & SW2)!=0) {                       // 2 番のスイッチが押された
    num = 2;
  } else if ((sw & SW1)!=0) {                       // 1 番のスイッチが押された
    num = 1;
  }
  return num;
}