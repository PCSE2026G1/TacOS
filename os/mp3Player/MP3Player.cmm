#include <kernel.hmm>
#include <util.hmm>
#include <mm.hmm>
#include <AudioDecoder.hmm>
#include <Clock.hmm>
#include <mp3Proc.hmm>
#include <fs.hmm>

#define CMMDEF
#include "key.h"
#include "appUtil.hmm"
#include "lcd.hmm"
#include "mp3Files.hmm"
#include "MP3Player.hmm"

#define MAX_MP3_FILES 5
#define MIN_PLAYER_SPEED 25
#define MAX_PLAYER_SPEED 200

int selectedFile = 1;
int playingFile = 0;
int playerMode = MP3PLAYER_LIST;
int playerSelectedItem = 0;
boolean playerPlaying = false;
boolean playerRepeat = false;
boolean playerShuffle = false;
boolean externalFileSelected = false;
boolean playerInfoReturnsToCaller = false;
char[] externalFile = array(256);
char[][] playerPlaylistFiles = null;
int playerPlaylistCount = 0;
int playerPlaylistIndex = 0;
boolean playerSourcePlaylist = false;
boolean playerInfoVisible = false;
int playerSem = -1;
char[] shuffleCandidate = array(16);

#define PLAYER_ITEM_TIME 0
#define PLAYER_ITEM_VOLUME 1
#define PLAYER_ITEM_SPEED 2
#define PLAYER_ITEM_REPEAT 3
#define PLAYER_ITEM_SHUFFLE 4
#define PLAYER_ITEM_COUNT 5

int countMP3Files() {
  int count = 0;
  for (int i=1; i<=MAX_MP3_FILES; i=i+1) {
    if (mp3FilesGetName(i)!=null) count = count+1;
  }
  return count;
}

int nextSelection(int selected, int direction, int count) {
  if (count<=0) return 0;
  selected = selected+direction;
  if (selected<1) selected = count;
  if (selected>count) selected = 1;
  return selected;
}

int clampVolume(int volume) {
  if (volume<0) return 0;
  if (volume>0xfe) return 0xfe;
  return volume;
}

int clampSpeed(int speed) {
  if (speed<MIN_PLAYER_SPEED) return MIN_PLAYER_SPEED;
  if (speed>MAX_PLAYER_SPEED) return MAX_PLAYER_SPEED;
  return speed;
}

int shuffleSelection(int current, int count, int randomValue) {
  if (count<=0) return 0;
  if (count==1) return 1;

  int selected = (randomValue&0x7fff)%count+1;
  if (selected==current) selected = selected%count+1;
  return selected;
}

int selectionAfterFinish(int current, int count, boolean repeat,
                         boolean shuffle, int randomValue) {
  if (count<=0) return 0;
  if (repeat) return current;
  if (shuffle) return shuffleSelection(current, count, randomValue);
  return 0;
}

/* Playlistでは添字が0から始まる．Repeat／Shuffleの次曲を決める． */
int playlistSelectionAfterFinish(int current, int count, boolean repeat,
                                 boolean shuffle, int randomValue) {
  if (count<=0) return -1;
  if (repeat) return current;
  if (!shuffle) return -1;
  if (count==1) return 0;

  int next = (randomValue&0x7fff)%count;
  if (next==current) next = (next+1)%count;
  return next;
}

#ifdef MP3PLAYER_UNIT_TEST
boolean printMP3PlayerTest(char[] name, boolean result) {
#ifdef DEBUG
  if (result) printF("[OK] %s\n", name);
  else printF("[NG] %s\n", name);
#endif
  return result;
}
#endif

boolean isCurrentExternalName(char[] name) {
  int start = 0;
  for (int i=0; externalFile[i]!='\0'; i=i+1) {
    if (externalFile[i]=='/') start = i+1;
  }
  int i = 0;
  while (name[i]!='\0' && externalFile[start+i]!='\0') {
    if (name[i]!=externalFile[start+i]) return false;
    i = i+1;
  }
  return name[i]=='\0' && externalFile[start+i]=='\0';
}

/* /MP3直下の全MP3から，現在と異なる1曲を選ぶ． */
boolean selectExternalShuffleFile() {
  shuffleCandidate[0] = '\0';
  int fd = open("/MP3", READ_MODE);
  if (fd<0) return false;
  int count = 0;
  for (;;) {
    Dir entry = readDir(fd, "MP3");
    if (entry==null) break;
    if (isCurrentExternalName(entry.name)) continue;
    count = count+1;
    if (((rand()&0x7fff)%count)==0)
      strCpy(shuffleCandidate, entry.name);
  }
  close(fd);

  if (shuffleCandidate[0]=='\0') return true;
  strCpy(externalFile, "/MP3/");
  int i = 0;
  while (shuffleCandidate[i]!='\0') {
    externalFile[5+i] = shuffleCandidate[i];
    i = i+1;
  }
  externalFile[5+i] = '\0';
  return true;
}

void putShortPath(char[] path) {
  int length = strLen(path);
  int start = 0;
  for (int i=0; i<length; i=i+1) {
    if (path[i]=='/') start = i+1;
  }
  int end = length;
  if (length-start>=4 && path[length-4]=='.' &&
      (path[length-3]=='M' || path[length-3]=='m') &&
      (path[length-2]=='P' || path[length-2]=='p') &&
      path[length-1]=='3') end = length-4;
  int printed = 0;
  for (int i=start; i<end && printed<14; i=i+1) {
    putCh(path[i]);
    printed = printed+1;
  }
}

void drawListScreen() {
  int count = countMP3Files();
  cls();
  locateXY(0, 0); putStr("# FILES #");

  if (count==0) {
    locateXY(1, 3); putStr("No MP3 files");
  } else {
    for (int i=1; i<=count; i=i+1) {
      locateXY(0, i);
      if (i==selectedFile) putCh('*');
      else putCh(' ');
      putCh(' ');
      putStr(mp3FilesGetName(i));
    }
  }

  locateXY(0, 7); putStr("ENT:Play BACK:Home");
}

void drawPlayerBar(int value, int maximum) {
  int count = 0;
  if (maximum>0) count = value*16/maximum;
  if (count<0) count = 0;
  if (count>16) count = 16;
  for (int i=0; i<16; i=i+1) {
    if (i<count) putCh('#');
    else putCh('-');
  }
}

void drawPlayerMark(int item) {
  if (playerSelectedItem==item) putCh('*');
  else putCh(' ');
}

void drawInfoScreen() {
  cls();
  locateXY(0, 0);
  if (playerSourcePlaylist) putStr("P:");
  else if (externalFileSelected) putStr("F:");
  if (externalFileSelected && playingFile==0) {
    putShortPath(externalFile);
  } else if (playingFile>0 && mp3FilesGetName(playingFile)!=null) {
    putStr(mp3FilesGetName(playingFile));
  } else {
    putStr("Not playing");
  }

  locateXY(0, 1); drawPlayerMark(PLAYER_ITEM_TIME); putStr(" Time ");
  /* getTotalTime()が未実装なので，誤った進捗率は表示しない． */
  locateXY(0, 2); drawPlayerBar(0, 16);
  locateXY(0, 3); drawPlayerMark(PLAYER_ITEM_VOLUME); putStr(" volume:");
  locateXY(0, 4); drawPlayerMark(PLAYER_ITEM_SPEED); putStr(" speed:");
  locateXY(0, 5); drawPlayerMark(PLAYER_ITEM_REPEAT); putStr(" Repeat:");
  if (playerRepeat) putStr("ON"); else putStr("OFF");
  locateXY(0, 6); drawPlayerMark(PLAYER_ITEM_SHUFFLE); putStr(" Shuffle:");
  if (playerShuffle) putStr("ON"); else putStr("OFF");
  locateXY(0, 7); putStr("ENT:Play/Stop");
}

void clearPlaylistContext() {
  if (playerPlaylistFiles!=null) {
    for (int i=0; i<playerPlaylistCount; i=i+1) {
      if (playerPlaylistFiles[i]!=null) free(playerPlaylistFiles[i]);
    }
    free(playerPlaylistFiles);
  }
  playerPlaylistFiles = null;
  playerPlaylistCount = 0;
  playerPlaylistIndex = 0;
  playerSourcePlaylist = false;
}

boolean copyPlaylistContext(char[][] files, int count) {
  clearPlaylistContext();
  playerPlaylistFiles = malloc(count*2);
  if (playerPlaylistFiles==null) return false;
  playerPlaylistCount = count;

  for (int i=0; i<count; i=i+1) playerPlaylistFiles[i] = null;
  for (int i=0; i<count; i=i+1) {
    int length = strLen(files[i]);
    playerPlaylistFiles[i] = malloc(length+1);
    if (playerPlaylistFiles[i]==null) {
      clearPlaylistContext();
      return false;
    }
    strCpy(playerPlaylistFiles[i], files[i]);
  }
  playerSourcePlaylist = true;
  return true;
}

void updateInfoValues() {
  locateXY(7, 1); putDec(getPosition(), 5); putStr(" sec");
  locateXY(9, 3); putDec(getVolume(), 3); putStr("   ");
  locateXY(8, 4); putDec(getSpeed(), 3); putCh('%'); putStr("  ");
}

void playSelectedFile() {
  char[] path = mp3FilesGetPath(selectedFile);
  if (path==null) return;

  if (playerSourcePlaylist) {
    playerPlaying = false;
    clearPlaylistContext();
  }
  playerPlaying = false;
  if (MP3playfile(path, true)) {
    externalFileSelected = false;
    playingFile = selectedFile;
    playerPlaying = true;
    playerMode = MP3PLAYER_INFO;
    if (playerInfoVisible) drawInfoScreen();
#ifdef DEBUG
    printF("MP3Player play=%s state=%d\n", path, getPlaybackState());
#endif
  } else {
#ifdef DEBUG
    printF("MP3Player play failed=%s\n", path);
#endif
  }
}

void playExternalFile() {
  if (externalFile[0]=='\0') return;
  playerPlaying = false;
  if (MP3playfile(externalFile, true)) {
    playingFile = 0;
    playerPlaying = true;
    externalFileSelected = true;
    playerMode = MP3PLAYER_INFO;
    if (playerInfoVisible) drawInfoScreen();
  }
}

void playPlaylistFile(int index) {
  if (playerPlaylistFiles==null || index<0 || index>=playerPlaylistCount) return;
  playerPlaylistIndex = index;
  strCpy(externalFile, playerPlaylistFiles[index]);
  playExternalFile();
}

void stopPlayerFile() {
  MP3stop();
  playerPlaying = false;
  updateInfoValues();
#ifdef DEBUG
  printF("MP3Player stopped\n");
#endif
}

void togglePlayerFile() {
  if (playerPlaying) {
    stopPlayerFile();
    return;
  }

  if (playingFile>0) selectedFile = playingFile;
  if (externalFileSelected) playExternalFile();
  else playSelectedFile();
}

void changePlayerItem(int difference) {
  playerSelectedItem = playerSelectedItem+difference;
  if (playerSelectedItem<0) playerSelectedItem = PLAYER_ITEM_COUNT-1;
  if (playerSelectedItem>=PLAYER_ITEM_COUNT) playerSelectedItem = 0;
  drawInfoScreen();
  updateInfoValues();
}

void changePlayerVolume(int difference) {
  int oldVolume = getVolume();
  int volume = clampVolume(oldVolume+difference);
  setVolume(volume);
  updateInfoValues();
#ifdef DEBUG
  printF("MP3Player volume=%d->%d\n", oldVolume, volume);
#endif
}

void changePlayerSpeed(int difference) {
  if (!playerPlaying) {
#ifdef DEBUG
    printF("MP3Player speed:NOT PLAYING\n");
#endif
    return;
  }

  int oldSpeed = getSpeed();
  int newSpeed = clampSpeed(oldSpeed+difference);

  if (newSpeed==oldSpeed) {
#ifdef DEBUG
    printF("MP3Player speed=%d limit\n", oldSpeed);
#endif
    return;
  }

  if (setSpeed(newSpeed)) {
    updateInfoValues();
#ifdef DEBUG
    printF("MP3Player speed=%d->%d OK\n", oldSpeed, newSpeed);
#endif
  } else {
#ifdef DEBUG
    printF("MP3Player speed=%d->%d REJECTED\n", oldSpeed, newSpeed);
#endif
  }
}

void changeSelectedPlayerValue(int difference) {
  if (playerSelectedItem==PLAYER_ITEM_VOLUME) {
    changePlayerVolume(difference);
  } else if (playerSelectedItem==PLAYER_ITEM_SPEED) {
    changePlayerSpeed(difference);
  } else if (playerSelectedItem==PLAYER_ITEM_REPEAT) {
    playerRepeat = !playerRepeat;
    if (playerRepeat) playerShuffle = false;
    drawInfoScreen();
    updateInfoValues();
  } else if (playerSelectedItem==PLAYER_ITEM_SHUFFLE) {
    playerShuffle = !playerShuffle;
    if (playerShuffle) playerRepeat = false;
    drawInfoScreen();
    updateInfoValues();
  }
}

void handleNaturalFinish(int count) {
  if (!playerPlaying || getPlaybackState()!=MP3_STATE_FINISHED) return;

  if (playerSourcePlaylist) {
    int nextIndex = playlistSelectionAfterFinish(
        playerPlaylistIndex, playerPlaylistCount,
        playerRepeat, playerShuffle, rand());
    playerPlaying = false;
    if (nextIndex>=0) playPlaylistFile(nextIndex);
    else {
      clearPlaylistContext();
      if (playerInfoVisible) {
        drawInfoScreen();
        updateInfoValues();
      }
    }
    return;
  }

  if (externalFileSelected) {
    playerPlaying = false;
    if (playerRepeat) playExternalFile();
    else if (playerShuffle && selectExternalShuffleFile()) playExternalFile();
    else if (playerInfoVisible) {
      drawInfoScreen();
      updateInfoValues();
    }
    return;
  }

  int finishedFile = playingFile;
  int nextFile = selectionAfterFinish(finishedFile, count,
                                      playerRepeat, playerShuffle, rand());
  playerPlaying = false;

#ifdef DEBUG
  printF("MP3Player natural end=%d\n", finishedFile);
#endif

  if (nextFile>0) {
    selectedFile = nextFile;
#ifdef DEBUG
    if (playerRepeat) printF("MP3Player repeat=%d\n", nextFile);
    else printF("MP3Player shuffle=%d->%d\n", finishedFile, nextFile);
#endif
    playSelectedFile();
  } else {
    if (playerInfoVisible) {
      drawInfoScreen();
      updateInfoValues();
    }
  }
}

#ifdef MP3PLAYER_UNIT_TEST
public boolean testMP3Player() {
  int count = countMP3Files();
  boolean result = true;

#ifdef DEBUG
  printF("--- MP3Player test ---\n");
  printF("file count=%d\n", count);
#endif

  if (!printMP3PlayerTest("file count range",
                         count>=0 && count<=MAX_MP3_FILES)) result = false;
  if (!printMP3PlayerTest("empty selection",
                         nextSelection(1, 1, 0)==0)) result = false;
  if (!printMP3PlayerTest("single up",
                         nextSelection(1, -1, 1)==1)) result = false;
  if (!printMP3PlayerTest("single down",
                         nextSelection(1, 1, 1)==1)) result = false;
  if (!printMP3PlayerTest("volume lower bound",
                         clampVolume(-1)==0)) result = false;
  if (!printMP3PlayerTest("volume normal",
                         clampVolume(40)==40)) result = false;
  if (!printMP3PlayerTest("volume upper bound",
                         clampVolume(300)==0xfe)) result = false;
  if (!printMP3PlayerTest("initial volume 40",
                         getVolume()==40)) result = false;
  if (!printMP3PlayerTest("volume step up",
                         clampVolume(40+1)==41)) result = false;
  if (!printMP3PlayerTest("volume step down",
                         clampVolume(40-1)==39)) result = false;
  if (!printMP3PlayerTest("speed lower bound",
                         clampSpeed(20)==MIN_PLAYER_SPEED)) result = false;
  if (!printMP3PlayerTest("speed normal",
                         clampSpeed(100)==100)) result = false;
  if (!printMP3PlayerTest("speed upper bound",
                         clampSpeed(205)==MAX_PLAYER_SPEED)) result = false;
  if (!printMP3PlayerTest("speed step up",
                         clampSpeed(100+1)==101)) result = false;
  if (!printMP3PlayerTest("speed step down",
                         clampSpeed(100-1)==99)) result = false;
  if (!printMP3PlayerTest("playback initially stopped",
                         getPlaybackState()==MP3_STATE_STOPPED)) result = false;

  strCpy(externalFile, "/MP3/MAOU_31.MP3");
  if (!printMP3PlayerTest("external source name match",
                         isCurrentExternalName("MAOU_31.MP3"))) result = false;
  if (!printMP3PlayerTest("external source name differs",
                         !isCurrentExternalName("MAOU_32.MP3"))) result = false;
  externalFile[0] = '\0';

  if (!printMP3PlayerTest("finish without mode stops",
                         selectionAfterFinish(2, 5, false, false, 3)==0)) {
    result = false;
  }
  if (!printMP3PlayerTest("repeat keeps current file",
                         selectionAfterFinish(2, 5, true, false, 3)==2)) {
    result = false;
  }
  if (!printMP3PlayerTest("shuffle changes file",
                         selectionAfterFinish(2, 5, false, true, 1)!=2)) {
    result = false;
  }
  if (!printMP3PlayerTest("shuffle remains in range",
                         selectionAfterFinish(5, 5, false, true, 32767)>=1 &&
                         selectionAfterFinish(5, 5, false, true, 32767)<=5)) {
    result = false;
  }
  if (!printMP3PlayerTest("single-file shuffle",
                         selectionAfterFinish(1, 1, false, true, 9)==1)) {
    result = false;
  }
  if (!printMP3PlayerTest("playlist repeat keeps current",
      playlistSelectionAfterFinish(2, 4, true, false, 0)==2)) result = false;
  if (!printMP3PlayerTest("playlist shuffle changes current",
      playlistSelectionAfterFinish(2, 4, false, true, 2)!=2)) result = false;
  if (!printMP3PlayerTest("playlist shuffle stays in range",
      playlistSelectionAfterFinish(3, 4, false, true, 32767)>=0 &&
      playlistSelectionAfterFinish(3, 4, false, true, 32767)<4)) result = false;
  if (!printMP3PlayerTest("playlist no mode stops",
      playlistSelectionAfterFinish(2, 4, false, false, 0)==-1)) result = false;
  if (!printMP3PlayerTest("playlist single shuffle",
      playlistSelectionAfterFinish(0, 1, false, true, 9)==0)) result = false;

  if (count>0) {
    boolean filesValid = true;
    for (int i=1; i<=count; i=i+1) {
      if (mp3FilesGetName(i)==null || mp3FilesGetPath(i)==null) {
        filesValid = false;
      }
    }
    if (!printMP3PlayerTest("all file names and paths", filesValid)) result = false;
    if (!printMP3PlayerTest("wrap upward",
                            nextSelection(1, -1, count)==count)) result = false;
    if (!printMP3PlayerTest("wrap downward",
                            nextSelection(count, 1, count)==1)) result = false;
  }
  if (!printMP3PlayerTest("out of range file",
                          mp3FilesGetName(MAX_MP3_FILES+1)==null)) result = false;
#ifdef DEBUG
  if (result) printF("MP3Player test:PASS\n");
  else printF("MP3Player test:FAIL\n");
#endif
  return result;
}
#endif

public void showMP3PlayerFile(char[] file) {
  if (file==null || file[0]=='\0') return;
  playerPlaying = false;
  clearPlaylistContext();
  strCpy(externalFile, file);
  playExternalFile();
  if (playerPlaying) {
    playerInfoReturnsToCaller = true;
    showMP3Player(MP3PLAYER_INFO);
    playerInfoReturnsToCaller = false;
  }
}

public void showMP3PlayerPlaylist(char[][] files, int count, int selected) {
  if (files==null || count<=0 || selected<0 || selected>=count) return;
  playerPlaying = false;
  if (!copyPlaylistContext(files, count)) return;
  playPlaylistFile(selected);
  if (!playerPlaying) {
    clearPlaylistContext();
    return;
  }
  if (playerPlaying) {
    playerInfoReturnsToCaller = true;
    showMP3Player(MP3PLAYER_INFO);
    playerInfoReturnsToCaller = false;
  }
  if (!playerPlaying) clearPlaylistContext();
}

public boolean isMP3PlayerPlaying() {
  return playerPlaying;
}

public void mp3PlayerTick() {
  handleNaturalFinish(countMP3Files());
}

public void MP3PlayerInit() {
  playerSem = newSem(1);
  if (playerSem<0) panic("MP3PlayerInit newSem");
}

public void mp3PlayerMonitorMain() {
  for (;;) {
    semP(playerSem);

    if (isAlarmRinging()) {
      playerPlaying = false;
      playerInfoVisible = false;
      clearPlaylistContext();
    } else {
      mp3PlayerTick();
    }

    semV(playerSem);
    sleep(100);
  }
}

public void mp3PlayerInterrupted() {
  semP(playerSem);
  playerPlaying = false;
  playerInfoVisible = false;
  clearPlaylistContext();
  semV(playerSem);
}

public void showCurrentMP3Player() {
  if (!playerPlaying) return;
  playerInfoReturnsToCaller = true;
  showMP3Player(MP3PLAYER_INFO);
  playerInfoReturnsToCaller = false;
  if (!playerPlaying) clearPlaylistContext();
}

void waitPlayerKeysReleased() {
  int released = 0;

  while (released<3) {
    key_step();

    if (key_read()==0) {
      released = released+1;
    } else {
      released = 0;
    }

    sleep(10);
  }
}

public void showMP3Player(int type) {
  int count = countMP3Files();
  if (count>0) selectedFile = 1;
  else selectedFile = 0;

  if (type==MP3PLAYER_INFO) playerMode = MP3PLAYER_INFO;
  else playerMode = MP3PLAYER_LIST;
  playerInfoVisible = playerMode==MP3PLAYER_INFO;
  playerSelectedItem = PLAYER_ITEM_TIME;
  srand(getPosition()+1);

  if (playerMode==MP3PLAYER_LIST) drawListScreen();
  else drawInfoScreen();

  waitPlayerKeysReleased();

  int refresh = 0;
  for (;;) {
    key_step();
    if (playerMode==MP3PLAYER_LIST) {
      if (key_pressed(KEY_UP)!=0) {
        selectedFile = nextSelection(selectedFile, -1, count);
        drawListScreen();
#ifdef DEBUG
        printF("MP3Player key=UP selected=%d\n", selectedFile);
#endif
      } else if (key_pressed(KEY_DOWN)!=0) {
        selectedFile = nextSelection(selectedFile, 1, count);
        drawListScreen();
#ifdef DEBUG
        printF("MP3Player key=DOWN selected=%d\n", selectedFile);
#endif
      } else if (key_pressed(KEY_ENTER)!=0 && count>0) {
        playSelectedFile();
        if (playerMode==MP3PLAYER_INFO) {
          playerInfoVisible = true;
          drawInfoScreen();
          updateInfoValues();
        }
      } else if (key_pressed(KEY_RIGHT)!=0) {
        playerMode = MP3PLAYER_INFO;
        playerInfoVisible = true;
        drawInfoScreen();
        updateInfoValues();
#ifdef DEBUG
        printF("MP3Player screen=INFO\n");
#endif
      } else if (key_pressed(KEY_BACK)!=0) {
        playerInfoVisible = false;
        return;
      }
    } else {
      if (key_pressed(KEY_UP)!=0) {
        changePlayerItem(-1);
      } else if (key_pressed(KEY_DOWN)!=0) {
        changePlayerItem(1);
      } else if (key_pressed(KEY_LEFT)!=0) {
        changeSelectedPlayerValue(-1);
      } else if (key_pressed(KEY_RIGHT)!=0) {
        changeSelectedPlayerValue(1);
      } else if (key_pressed(KEY_ENTER)!=0) {
        togglePlayerFile();
        drawInfoScreen();
        updateInfoValues();
      } else if (key_pressed(KEY_BACK)!=0) {
        if (playerInfoReturnsToCaller) {
          playerInfoVisible = false;
          return;
        }
        playerMode = MP3PLAYER_LIST;
        playerInfoVisible = false;
        drawListScreen();
#ifdef DEBUG
        printF("MP3Player screen=LIST\n");
#endif
      }
    }

    refresh = refresh+1;
    if (playerMode==MP3PLAYER_INFO && refresh>=25) {
      updateInfoValues();
      refresh = 0;
    }
    sleep(10);
  }
}
