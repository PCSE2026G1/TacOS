#include "Clock.hmm"
#include "kernel.hmm"
#include "util.hmm"
#include "mm.hmm"
#include "AudioDecoder.hmm"

Time currentTime = {1900, 1, 1, 0, 0, 0};
Time alarmTime = {1900, 1, 1, 0, 0, 0};
Time timerTime = {0, 0, 0, 0, 0, 0};

int sem;

char[] alarmFile = null;
boolean alarmSet = false;

void copyTime(Time dst, Time src) {
    if (dst==null || src==null) panic("copyTime");

    dst.year = src.year;
    dst.mon = src.mon;
    dst.day = src.day;
    dst.hour = src.hour;
    dst.min = src.min;
    dst.sec = src.sec;
}

boolean isLeapYear(int year) {
    if ((year % 400)==0) return true;
    if ((year % 100)==0) return false;

    return (year % 4)==0;
}

int daysInMonth(int year, int mon) {
    if (mon==2) {
        if (isLeapYear(year)) return 29;
        return 28;
    }

    if (mon==4 || mon==6 || mon==9 || mon==11) {
        return 30;
    }
    return 31;
}

boolean isValidTime(Time time) {
    if (time==null) return false;
    if (time.year<0) return false;
    if (time.mon<1 || time.mon>12) return false;

    if (time.day<1 || time.day>daysInMonth(time.year, time.mon)) {
        return false;
    }

    if (time.hour<0 || time.hour>23) return false;
    if (time.min<0 || time.min>59) return false;
    if (time.sec<0 || time.sec>59) return false;

    return true;
}

boolean timesEqual(Time time1, Time time2) {
    return time1.year==time2.year &&
           time1.mon==time2.mon &&
           time1.day==time2.day &&
           time1.hour==time2.hour &&
           time1.min==time2.min &&
           time1.sec==time2.sec;
}

void increaseSecond(Time time){
    time.sec = time.sec+1;
    if (time.sec<60) return;
    time.sec = 0;

    time.min = time.min+1;
    if (time.min<60) return;
    time.min = 0;

    time.hour = time.hour+1;
    if (time.hour<24) return;
    time.hour = 0;

    time.day = time.day+1;
    if (time.day>daysInMonth(time.year, time.mon)) {
        time.day = 1;
        time.mon = time.mon+1;
    }

    if (time.mon>12) {
        time.mon = 1;
        time.year = time.year+1;
    }
}

public void getTime(Time time) {
    semP(sem);
    copyTime(time, currentTime);
    semV(sem);
}

public boolean setTime(Time time) {
    if (!isValidTime(time)) return false;
    semP(sem);
    copyTime(currentTime, time);
    semV(sem);
    return true;
}

public void getAlarm(Time time) {
    semP(sem);
    copyTime(time, alarmTime);
    semV(sem);
}

public boolean setAlarm(Time time) {
    if (!isValidTime(time)) return false;

    semP(sem);
    if (alarmFile==null) {
        semV(sem);
        return false;
    }
    copyTime(alarmTime, time);
    alarmSet = true;
    semV(sem);
    return true;
}

public boolean isAlarmSet() {
    semP(sem);
    boolean result = alarmSet;
    semV(sem);
    return result;
}

public void clearAlarm() {
    semP(sem);
    alarmSet = false;
    semV(sem);
}

public char[] getFile() {
    semP(sem);
    char[] file = alarmFile;
    semV(sem);
    return file;
}

public boolean setFile(char[] file) {
    char[] newFile = null;
    if(file != null){
        int length = strLen(file);
        newFile = malloc(length+1);
        if (newFile==null) return false;
        strCpy(newFile, file);
    }

    semP(sem);
    char[] oldFile = alarmFile;
    alarmFile = newFile;
    if (alarmFile==null) alarmSet = false;
    semV(sem);

    if (oldFile!=null) free(oldFile);
    return true;
}

public boolean setTimer(Time time) {
    if (!isValidTime(time)) return false;

    semP(sem);
    copyTime(timerTime, time);
    semV(sem);
    return true;
}

public void clockMain(){
    for(;;){
        sleep(1000);
        boolean playAlarm = false;
        char[] file = null;

        semP(sem);
        increaseSecond(currentTime);

        if (alarmSet && timesEqual(currentTime, alarmTime)) {
            alarmSet = false;
            if (alarmFile!=null) {
                int length = strLen(alarmFile);
                file = malloc(length+1);
                if (file==null) panic("clock alarm malloc");
                strCpy(file, alarmFile);
                playAlarm = true;
            }
        }
        semV(sem);

        if (playAlarm) {
            if (!MP3playfile(file, false)) {
#ifdef DEBUG
                dbgPutStr("alarm play failed\n");
#endif
            }
            free(file);
        }
    }
}

public void ClockInit(){
    sem = newSem(1);
    if (sem<0) panic("ClockInit newSem");
}
