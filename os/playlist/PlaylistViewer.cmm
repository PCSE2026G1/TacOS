#include <util.hmm>
#include <mm.hmm>
#include <MP3Player.hmm>
#include <list.hmm>
#include <file_chooser.hmm>

#include "Playlist.hmm"
#include "PlaylistViewer.hmm"

char[] createPlaylistDisplayName(char[] path) {
    int start = 0;
    int end = strLen(path);

    // 最後の '/' の次がファイル名の先頭．
    for (int i=0; i<end; i=i+1) {
        if (path[i]=='/') {
            start = i+1;
        }
    }

    // // ファイル名内の最後の '.' 以降を拡張子として除く．
    // int dot = end;

    // for (int i=start; i<end; i=i+1) {
    //     if (path[i]=='.') {
    //         dot = i;
    //     }
    // }

    // if (dot>start) {
    //     end = dot;
    // }

    int length = end-start;

    if (length<=0) {
        dbgPutStr("PlaylistViewer: invalid display name\n");
        return null;
    }

    // 既存List部品の名前表示欄は14文字．
    if (length>14) {
        length = 14;
    }

    char[] name = malloc(length+1);

    if (name==null) {
        dbgPutStr("PlaylistViewer: display name malloc failed\n");
        return null;
    }

    for (int i=0; i<length; i=i+1) {
        name[i] = path[start+i];
    }

    name[length] = '\0';
    return name;
}

boolean addPlaylistFileFromChooser(Playlist playlist) {
    if (playlist==null) {
        panic("PlaylistViewer: null playlist");
    }

    char[] path = malloc(256);

    if (path==null) {
        dbgPutStr("PlaylistViewer: chooser buffer malloc failed\n");
        return false;
    }

    path[0] = '\0';
    chooserMp3(path);

    // FileChooserはキャンセル・内部エラーとも空文字列で戻り得る．
    if (path[0]=='\0') {
        dbgPutStr("PlaylistViewer: no file selected\n");
        free(path);
        return false;
    }

    int length = strLen(path);

    if (length<4 ||
        path[length-4]!='.' ||
        (path[length-3]!='m' && path[length-3]!='M') ||
        (path[length-2]!='p' && path[length-2]!='P') ||
        path[length-1]!='3') {
        dbgPutStr("PlaylistViewer: selected file is not MP3\n");
        free(path);
        return false;
    }

    boolean added = addPlaylistFile(playlist, path);

    if (added) {
        dbgPutStr("PlaylistViewer: added ");
        dbgPutStr(path);
        dbgPutStr("\n");
    } else {
        dbgPutStr("PlaylistViewer: add failed\n");
    }

    // addPlaylistFile()はパスを内部でコピーしている．
    free(path);
    return added;
}

void showPlaylistSongs(Playlist playlist, boolean removeMode) {
    if (playlist==null) {
        panic("PlaylistViewer: null playlist");
    }


    int count = getPlaylistCount(playlist);

    if (count<=0) {
        dbgPutStr("PlaylistViewer: playlist is empty\n");
        // destroyPlaylist(playlist);
        return;
    }

    // TaCではポインタが2バイト．count*2の整数あふれを防ぐ．
    if (count>16383) {
        dbgPutStr("PlaylistViewer: too many files\n");
        // destroyPlaylist(playlist);
        return;
    }

    char[][] files = malloc(count*2);

    if (files==null) {
        dbgPutStr("PlaylistViewer: array malloc failed\n");
        // destroyPlaylist(playlist);
        return;
    }

    PlaylistItem item = playlist.front;

    char[] title = "PLAYLIST";

    if (removeMode) {
        title = "REMOVE SONG";
    }

    for (int i=0; i<count; i=i+1) {
        if (item==null || item.path==null) {
            panic("PlaylistViewer: broken playlist");
        }

        // パスの所有権は，まだplaylist側にある．
        files[i] = item.path;
        item = item.next;
    }

    if (item!=null) {
        panic("PlaylistViewer: count mismatch");
    }

    char[][] names = malloc(count*2);

    if (names==null) {
        dbgPutStr("PlaylistViewer: name array malloc failed\n");
        free(files);
        // destroyPlaylist(playlist);
        return;
    }

    for (int i=0; i<count; i=i+1) {
        names[i] = createPlaylistDisplayName(files[i]);

        if (names[i]==null) {
            // 作成済みの表示名だけを解放する．
            for (int j=0; j<i; j=j+1) {
                free(names[j]);
            }

            free(names);
            free(files);
            // destroyPlaylist(playlist);
            return;
        }
    }

    // dbgPutStr("PlaylistViewer: opening player\n");

    // // 先頭の曲を選択して，既存の再生詳細画面を開く．
    // showMP3PlayerPlaylist(files, count, 0);

    // // MP3Playerは受け取ったパスを内部でコピーする．
    // free(files);
    // destroyPlaylist(playlist);

    // dbgPutStr("PlaylistViewer: returned from player\n");
    for (;;) {
        // int selected = select("PLAYLIST", files, count);
        // int selected = select("PLAYLIST", names, count);
        int selected = select(title, names, count);

        // 一覧画面で戻るボタンを押した．
        if (selected==-1) {
            break;
        }

        // select()との契約に反する値は，バグとして検出する．
        if (selected<0 || selected>=count) {
            panic("PlaylistViewer: invalid selection");
        }

        if (removeMode) {
            // 削除後はパスも解放されるので，先に表示する．
            dbgPutStr("PlaylistViewer: removing ");
            dbgPutStr(files[selected]);
            dbgPutStr("\n");

            if (!removePlaylistFile(playlist, selected)) {
                panic("PlaylistViewer: removal failed");
            }

            dbgPutStr("PlaylistViewer: removed\n");

            // filesは削除前の一覧なので，もう使用せずループを抜ける．
            break;
        }

        dbgPutStr("PlaylistViewer: selected ");
        dbgPutStr(files[selected]);
        dbgPutStr("\n");

        showMP3PlayerPlaylist(files, count, selected);

        dbgPutStr("PlaylistViewer: returned to list\n");
    }

    // MP3Playerはパスを内部でコピーしているため，
    // 再生中にHomeへ戻る場合も，こちらの領域は解放できる．

    for (int i=0; i<count; i=i+1) {
        free(names[i]);
    }

    free(names);

    free(files);
    // destroyPlaylist(playlist);

    // dbgPutStr("PlaylistViewer: returned to Home\n");
    dbgPutStr("PlaylistViewer: song list closed\n");
}

public void showPlaylistViewer(char[] playlistFile) {
    if (playlistFile==null || playlistFile[0]=='\0') {
        dbgPutStr("PlaylistViewer: invalid file name\n");
        return;
    }

    Playlist playlist = createPlaylist();

    if (playlist==null) {
        dbgPutStr("PlaylistViewer: playlist malloc failed\n");
        return;
    }

    if (!loadPlaylist(playlist, playlistFile)) {
        dbgPutStr("PlaylistViewer: load failed\n");
        destroyPlaylist(playlist);
        return;
    }

    char[][] menu = malloc(5*2);

    if (menu==null) {
        dbgPutStr("PlaylistViewer: menu malloc failed\n");
        destroyPlaylist(playlist);
        return;
    }

    menu[0] = "Songs";
    menu[1] = "Add song";
    menu[2] = "Remove song";
    menu[3] = "Save copy";
    menu[4] = "Home";

    for (;;) {
        int action = select("PLAYLIST MENU", menu, 5);

        if (action==-1 || action==4) {
            break;
        }

        if (action==0) {
            showPlaylistSongs(playlist, false);
        } else if (action==1) {
            addPlaylistFileFromChooser(playlist);
        } else if (action==2) {
            showPlaylistSongs(playlist, true);
        } else if (action==3) {
            if (savePlaylist(playlist, "/PLSAVE.TXT")) {
                dbgPutStr("PlaylistViewer: saved copy /PLSAVE.TXT\n");
            } else {
                dbgPutStr("PlaylistViewer: save copy failed\n");
            }
        } else {
            panic("PlaylistViewer: invalid menu action");
        }
    }

    free(menu);
    destroyPlaylist(playlist);

    dbgPutStr("PlaylistViewer: returned to Home\n");
}