#include <kernel.hmm>
#include <util.hmm>
#include <mm.hmm>
#include <MP3Player.hmm>
#include <list.hmm>
#include <file_chooser.hmm>
#include <Clock.hmm>
#include <ClockViewer.hmm>

#include "Playlist.hmm"
#include "PlaylistViewer.hmm"

#define CMMDEF
#include <key.h>
#include <lcd.h>

#ifdef PLAYLIST_TRACE
#define PL_TRACE(message) dbgPutStr(message)
#else
#define PL_TRACE(message)
#endif

// この画面を操作するプロセスだけが使用する．
char[] playlistEditorLabel = array(15);
char[][] playlistExitChoices = array(3);

// 画面遷移前のボタン長押しを，遷移後へ持ち越さない．
void waitPlaylistEditorKeysReleased() {
    int released = 0;

    while (released<3) {
        if (isAlarmRinging()) return;
        key_step();

        if (key_read()==0) {
            released = released+1;
        } else {
            released = 0;
        }

        sleep(10);
    }
}

// タイトル1行・曲一覧6行・操作説明1行を描画する．
void drawPlaylistEditor(Playlist playlist, int cursor, char[] path) {
    int count = getPlaylistCount(playlist);

    if (count<0) {
        panic("PV01");
    }

    for (int y=0; y<8; y=y+1) {
        lcd_draw_string(0, y, "                ");
    }

    lcd_draw_string(0, 0, "# PLAYLIST #");
    lcd_draw_string(0, 7, "2:Add3:Del4:Back");

    if (count==0) {
        lcd_draw_string(0, 1, "(empty)");
        return;
    }

    if (cursor<0 || cursor>=count) {
        panic("PV02");
    }

    // カーソルを含む6曲分のページを表示する．
    int first = (cursor/6)*6;

    for (int row=0; row<6 && first+row<count; row=row+1) {
        int index = first+row;

        if (!getPlaylistFile(playlist, index, path, 256)) {
            panic("PV03");
        }

        // 最後の '/' より後ろをファイル名として表示する．
        int start = 0;

        for (int i=0; path[i]!='\0'; i=i+1) {
            if (path[i]=='/') {
                start = i+1;
            }
        }

        int length = 0;

        while (length<14 && path[start+length]!='\0') {
            playlistEditorLabel[length] = path[start+length];
            length = length+1;
        }

        playlistEditorLabel[length] = '\0';

        if (index==cursor) {
            lcd_draw_string(0, row+1, "*");
        }

        lcd_draw_string(2, row+1, playlistEditorLabel);
    }
}

// pathは呼出し元が確保した256バイトの作業領域．
// この関数では確保・解放しない．
boolean addPlaylistFileFromChooser(Playlist playlist, char[] path) {
    if (playlist==null) {
        panic("PV04");
    }

    path[0] = '\0';
    chooserMp3(path);

    // FileChooserはキャンセル・内部エラーとも空文字列で戻り得る．
    if (path[0]=='\0') {
        PL_TRACE("PL: no file selected\n");
        return false;
    }

    int length = strLen(path);

    if (length<4 ||
        path[length-4]!='.' ||
        (path[length-3]!='m' && path[length-3]!='M') ||
        (path[length-2]!='p' && path[length-2]!='P') ||
        path[length-1]!='3') {
        dbgPutStr("PV05\n");
        return false;
    }

    // addPlaylistFile()がパスを内部へコピーする．
    boolean added = addPlaylistFile(playlist, path);

    if (added) {
        PL_TRACE("PL: added ");
        PL_TRACE(path);
        PL_TRACE("\n");
    } else {
        dbgPutStr("PV06\n");
    }

    return added;
}

// 選択中の曲と，Playlist全体をMP3Playerへ渡す．
void openPlaylistEditorPlayer(Playlist playlist, int selected) {
    int count = getPlaylistCount(playlist);

    if (count<=0 || selected<0 || selected>=count) {
        panic("PV07");
    }

    // ポインタ配列のサイズ計算で整数あふれを起こさない．
    if (count>16383) {
        dbgPutStr("PV08\n");
        return;
    }

    char[][] files = malloc(count*2);

    if (files==null) {
        dbgPutStr("PV09\n");
        return;
    }

    PlaylistItem item = playlist.front;

    for (int i=0; i<count; i=i+1) {
        if (item==null || item.path==null) {
            panic("PV10");
        }

        files[i] = item.path;
        item = item.next;
    }

    if (item!=null) {
        panic("PV11");
    }

    PL_TRACE("PL: selected ");
    PL_TRACE(files[selected]);
    PL_TRACE("\n");

    // MP3Player側でパスをコピーして保持する．
    showMP3PlayerPlaylist(files, count, selected);

    // ここでは配列だけを解放する．各パスはPlaylistの所有物．
    free(files);

    PL_TRACE("PL: returned to list\n");
}

// trueなら画面を終了し，falseなら編集画面へ戻る．
boolean confirmPlaylistEditorExit(Playlist playlist, char[] playlistFile) {
    playlistExitChoices[0] = "Save";
    playlistExitChoices[1] = "Discard";
    playlistExitChoices[2] = "Cancel";

    int choice = selectWithAlarm("LEAVE PLAYLIST", playlistExitChoices, 3);

    // Alarm時は選択待ちを抜け，一覧の外側ループからClockを開く．
    if (choice==-2 || choice==-1 || choice==2) {
        return false;
    }

    if (choice==1) {
        return true;
    }

    if (choice!=0) {
        panic("PV12");
    }

    if (savePlaylist(playlist, playlistFile)) {
        PL_TRACE("PL: saved");
        PL_TRACE(playlistFile);
        PL_TRACE("\n");
        return true;
    }

    // 保存失敗時は編集内容を破棄せず，画面へ戻す．
    dbgPutStr("PV13\n");
    lcd_draw_string(0, 0, "Save failed     ");
    sleep(1000);

    return false;
}

public void showPlaylistViewer(char[] playlistFile) {
    if (playlistFile==null || playlistFile[0]=='\0') {
        dbgPutStr("PV14\n");
        return;
    }

    Playlist playlist = createPlaylist();

    if (playlist==null) {
        dbgPutStr("PV15\n");
        return;
    }

    if (!loadPlaylist(playlist, playlistFile)) {
        dbgPutStr("PV16\n");
        destroyPlaylist(playlist);
        return;
    }

    // 描画・追加・削除対象の確認に共用する作業領域．
    char[] path = malloc(256);

    if (path==null) {
        dbgPutStr("PV17\n");
        destroyPlaylist(playlist);
        return;
    }

    int cursor = 0;
    boolean redraw = true;

    waitPlaylistEditorKeysReleased();

    for (;;) {
        if (showClockViewerIfAlarmRinging()) {
            waitPlaylistEditorKeysReleased();
            redraw = true;
        }
        int count = getPlaylistCount(playlist);

        if (count<0) {
            panic("PV01");
        }

        // 最後の曲を削除した場合などにカーソルを補正する．
        if (count==0) {
            cursor = 0;
        } else if (cursor>=count) {
            cursor = count-1;
        }

        if (cursor<0) {
            panic("PV02");
        }

        if (redraw) {
            drawPlaylistEditor(playlist, cursor, path);
            redraw = false;
        }

        key_step();

        if (key_pressed(KEY_UP)!=0) {
            // ボタン1：上へ．
            if (cursor>0) {
                cursor = cursor-1;
                redraw = true;
            }
        } else if (key_pressed(KEY_DOWN)!=0) {
            // ボタン5：下へ．
            if (cursor<count-1) {
                cursor = cursor+1;
                redraw = true;
            }
        } else if (key_pressed(KEY_LEFT)!=0) {
            // ボタン2：曲を追加する．
            if (addPlaylistFileFromChooser(playlist, path)) {
                cursor = getPlaylistCount(playlist)-1;
            }

            waitPlaylistEditorKeysReleased();
            redraw = true;
        } else if (key_pressed(KEY_RIGHT)!=0) {
            // ボタン3：カーソル位置の曲を削除する．
            if (count>0) {
                if (!getPlaylistFile(playlist, cursor, path, 256)) {
                    panic("PV18");
                }

                PL_TRACE("PL: removing ");
                PL_TRACE(path);
                PL_TRACE("\n");

                if (!removePlaylistFile(playlist, cursor)) {
                    panic("PV19");
                }

                PL_TRACE("PL: removed\n");
                redraw = true;
            }
        } else if (key_pressed(KEY_ENTER)!=0) {
            // ボタン6：カーソル位置の曲を再生する．
            if (count>0) {
                openPlaylistEditorPlayer(playlist, cursor);
            }

            waitPlaylistEditorKeysReleased();
            redraw = true;
        } else if (key_pressed(KEY_BACK)!=0) {
            // ボタン4：保存・破棄・キャンセルを選択する．
            if (confirmPlaylistEditorExit(playlist, playlistFile)) {
                break;
            }

            waitPlaylistEditorKeysReleased();
            redraw = true;
        }

        sleep(10);
    }

    free(path);
    destroyPlaylist(playlist);

    PL_TRACE("PL: returned to Home\n");
}
