#include <fs.hmm>
#include <mp3Proc.hmm>
#include <spi.hmm>
#include <util.hmm>

#include "AudioDecoder.hmm"

// VS1011E SCI register addresses
#define SCI_DECODE_TIME 0x04
#define SCI_AUDATA      0x05
#define SCI_VOL         0x0b

#define MIN_SAMPLE_RATE_HALF  4000
#define MAX_SAMPLE_RATE_HALF 24000
#define PLAY_HISTORY_FILE "/playHistory.txt"

// SCI_AUDATA holds the sample rate in bits 15:1 and the channel flag in bit 0.
int baseAudioData = 0;
int speedValue = 100;
int volumeValue = 40;

boolean captureBaseAudioData() {
  int audioData = spiReadMp3Reg(SCI_AUDATA);
  if ((audioData & 0xfffe)==0) return false;
  baseAudioData = audioData;
  return true;
}

boolean addPlayHistory(char[] file) {
  int fd = open(PLAY_HISTORY_FILE, APPEND_MODE);
  if (fd<0) {
    if (creat(PLAY_HISTORY_FILE)<0) return false;
    fd = open(PLAY_HISTORY_FILE, APPEND_MODE);
    if (fd<0) return false;
  }

  int length = strLen(file);
  if (write(fd, file, length)!=length || write(fd, "\n", 1)!=1) {
    close(fd);
    return false;
  }

  close(fd);
  return true;
}

// volume is the VS1011E attenuation value (0: maximum, 254: silence).
public boolean setVolume(int volume) {
  if (volume<0 || volume>0xfe) return false;
  spiWriteMp3Reg(SCI_VOL, (volume<<8)|volume);
  volumeValue = volume;
  return true;
}

public int getVolume() {
  return spiReadMp3Reg(SCI_VOL)&0x00ff;
}

public boolean setSpeed(int speed) {
  if (speed<=0) return false;

  if (baseAudioData==0 && !captureBaseAudioData()) return false;

  int channel = baseAudioData&0x0001;
  int baseRateHalf = (baseAudioData>>1)&0x7fff;
  int quotient = baseRateHalf/100;
  int fraction = baseRateHalf%100;
  int newRateHalf = 0;
  int remainder = 0;

  // Calculate baseRateHalf*speed/100 without overflowing a 16-bit int.
  for (int i=0; i<speed; i=i+1) {
    newRateHalf = newRateHalf+quotient;
    remainder = remainder+fraction;
    if (remainder>=100) {
      newRateHalf = newRateHalf+1;
      remainder = remainder-100;
    }
    if (newRateHalf>MAX_SAMPLE_RATE_HALF) return false;
  }

  if (newRateHalf<MIN_SAMPLE_RATE_HALF ||
      newRateHalf>MAX_SAMPLE_RATE_HALF) return false;

  spiWriteMp3Reg(SCI_AUDATA, (newRateHalf<<1)|channel);
  speedValue = speed;
  return true;
}

public int getSpeed() {
  return speedValue;
}

public int getPosition() {
  return spiReadMp3Reg(SCI_DECODE_TIME);
}

public boolean MP3playfile(char[] file, boolean save) {
  if (file==null) return false;

  baseAudioData = 0;
  speedValue = 100;
  spiResetMp3();
  spiWriteMp3Reg(SCI_VOL, (volumeValue<<8)|volumeValue);
  if (!play(file)) return false;
  if (save && !addPlayHistory(file)) return false;
  return true;
}

public void MP3stop() {
  stop();
}

// VS1011E exposes elapsed decode time, but not the total duration of an MP3.
// Determining total duration requires parsing CBR/VBR MP3 metadata.
public int getTotalTime() {
  return -1;
}
