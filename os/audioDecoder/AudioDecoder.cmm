#include <mp3Proc.hmm>
#include <spi.hmm>

#include "AudioDecoder.hmm"

// VS1011E SCI register addresses
#define SCI_DECODE_TIME 0x04
#define SCI_AUDATA      0x05
#define SCI_VOL         0x0b

// SCI_AUDATA holds the sample rate in bits 15:1 and the channel flag in bit 0.
int baseAudioData = 0;
int speedValue = 100;

boolean captureBaseAudioData() {
  int audioData = spiReadMp3Reg(SCI_AUDATA);
  if ((audioData & 0xfffe)==0) return false;
  baseAudioData = audioData;
  return true;
}

// volume is the VS1011E attenuation value (0: maximum, 254: silence).
public void setVolume(int volume) {
  if (volume<0) volume = 0;
  if (volume>0xfe) volume = 0xfe;
  spiWriteMp3Reg(SCI_VOL, (volume<<8)|volume);
}

public int getVolume() {
  return spiReadMp3Reg(SCI_VOL)&0x00ff;
}

// Supported playback speeds are 25, 50, 75 and 100 percent.
public void setSpeed(int speed) {
  if (speed!=25 && speed!=50 && speed!=75 && speed!=100) return;

  if (baseAudioData==0 && !captureBaseAudioData()) return;

  int channel = baseAudioData&0x0001;
  int baseRate = baseAudioData&0xfffe;
  int newRate;

  if (speed==25) {
    newRate = baseRate>>2;
  } else if (speed==50) {
    newRate = baseRate>>1;
  } else if (speed==75) {
    newRate = (baseRate>>1)+(baseRate>>2);
  } else {
    newRate = baseRate;
  }

  spiWriteMp3Reg(SCI_AUDATA, (newRate&0xfffe)|channel);
  speedValue = speed;
}

public int getSpeed() {
  return speedValue;
}

public int getPosition() {
  return spiReadMp3Reg(SCI_DECODE_TIME);
}

public void MP3playfile(char[] file, boolean save) {
  baseAudioData = 0;
  speedValue = 100;
  spiResetMp3();
  play(file);

  // save is reserved for the play-history component. That component has not
  // been provided yet, so AudioDecoder must not call an undefined function.
}

public void MP3stop() {
  stop();
}

public void decoder(char[] buf, int size) {
  if (buf==null || size<=0) return;
  spiWriteMp3Dat(buf, size);
}

// VS1011E exposes elapsed decode time, but not the total duration of an MP3.
// Determining total duration requires parsing CBR/VBR MP3 metadata.
public int getTotalTime() {
  return -1;
}

public int getCurrentTime() {
  return getPosition();
}
