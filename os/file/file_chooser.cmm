#include <kernel.hmm>
#include <util.hmm>
#include "file_chooser.hmm"
#include "fs.hmm"
#include "file_manager.hmm"
#include "mm.hmm"
#include "list.hmm"


char[] name = array(13);

int count_file(char[] dir_name)
{
    int fd = open(dir_name, READ_MODE);
    int count = 0;

    int rslt;
    rslt = file_read_dir(fd, name);

    while (rslt != -1)
    {
        count = count + 1;
        rslt = file_read_dir(fd, name);
    }

    close(fd);

    return count;
}

public void chooser(char[] filename)
{
    int fd = open("/", READ_MODE);

    int size = count_file("/");

    char[][] arr = malloc(size * 2);

    for (int i = 0; i < size; i=i+1) {
        char[] name = malloc(13);
        file_read_dir(fd, name);

        arr[i] = name;
    }

    close(fd);

    int index = select("FILE", arr, size);
    char[] selected_name = arr[index];

    for (int i = 0; i < size; i=i+1) {
        free(arr[i]);
    }
    free(arr);

    strCpy(filename, selected_name);
}