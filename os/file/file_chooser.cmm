#include <kernel.hmm>
#include <util.hmm>
#include <string.hmm> 
#include "file_chooser.hmm"
#include "fs.hmm"
#include "file_manager.hmm"
#include "mm.hmm"
#include "list.hmm"


char[] name = array(16);

int count_file(char[] dir_name)
{
    int fd = open(dir_name, READ_MODE);
    int count = 0;

    int rslt;
    do
    {
        rslt = file_read_dir(fd, name);
        //エラー(-1)じゃないかつ終点(2)じゃなかったらカウント
        if (rslt != -1 && rslt != 2)
        {
            count = count + 1;
        }
    }
    while (rslt != -1 && rslt != 2);

    close(fd);

    return count;
}

public void chooser(char[] filename)
{
    char[] current_path = malloc(16);
    strCpy(current_path, "/");

    while (true) {
        int fd = open(current_path, READ_MODE);

        int size = count_file(current_path);

        char[][] arr = malloc(size * 2);
        int[] types = malloc(size * 2);

        for (int i = 0; i < size; i = i + 1) {
            char[] name = malloc(16);

            int type = file_read_dir(fd, name);

            arr[i] = name;
            types[i] = type;
        }

        close(fd);

        int index = select(current_path, arr, size);

        char[] selected_name = arr[index];

        // ファイルだった場合
        if (types[index] == 0) {
            strCpy(filename, current_path);

            if (strCmp(current_path, "/") != 0) {
                strCat(filename, "/");
            }

            strCat(filename, selected_name);

            for (int i = 0; i < size; i = i + 1) {
                free(arr[i]);
            }

            free(arr);
            free(types);
            free(current_path);

            return;
        }

        // ディレクトリだった場合
        else {
            char[] new_path = malloc(16);

            strCpy(new_path, current_path);

            if (strCmp(current_path, "/") != 0) {
                strCat(new_path, "/");
            }

            strCat(new_path, selected_name);

            free(current_path);
            current_path = new_path;
        }

        for (int i = 0; i < size; i = i + 1) {
            free(arr[i]);
        }

        free(arr);
        free(types);
    }
}