#include "file_chooser.hmm"


int count_file(char *dir_name)
{
    int fd = open(dir_name); // 調べて <3
    unsigned int count = 0;

    int rslt;
    while ((rslt = file_read_dir(fd, name)) != -1)
    {
        count++;
    }

    close(fd); // 自分で調べて :)

    return count;
}

public void chooser(char *filename)
{
    int fd = open("/");
    //freeを忘れずに
    int size = count_file();

    char[][] arr = malloc(size*2)

    for(int i = 0;i < size; i++){
        char[] name = malloc(13)
        file_read_dir(fd, name);

        // if (type == -1) {
        //     break;
        // }
        arr[i] = name

        
    }

    close(fd);
    
    int i = select("FILE", arr, size);  //配列一覧とサイズを渡すと、selectがカーソル位置を返してくれる
    char[] selected_name = arr[i]
    
    //arrのfree
    for(int i = 0;i<size; i++){
        free(arr[i]);
    }
    free(arr);
    


    strcpy(filename, selected_name);
}