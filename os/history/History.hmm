// 履歴を曲ごとに集計し，ファイル名と再生回数を表示する．
// 戻る操作で呼出し元へ戻る．
public void showHistory();

#ifdef HISTORY_UNIT_TEST
public boolean testHistory();
public void testHistoryViewer();
#endif

#endif