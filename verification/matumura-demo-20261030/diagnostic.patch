diff --git a/os/clock/Clock.cmm b/os/clock/Clock.cmm
index b08ae45..b6bc75f 100644
--- a/os/clock/Clock.cmm
+++ b/os/clock/Clock.cmm
@@ -3,6 +3,7 @@
 #include "util.hmm"
 #include "mm.hmm"
 #include "AudioDecoder.hmm"
+#include <mp3Proc.hmm>
 
 Time currentTime = {1900, 1, 1, 0, 0, 0};
 Time alarmTime = {1900, 1, 1, 0, 0, 0};
@@ -13,6 +14,8 @@ int sem;
 char[] currentFile = null;
 char[] alarmFile = null;
 char[] timerFile = null;
+// 鳴動開始時のパスを所有する．停止するまで保持し，自然終了後の再生に使う．
+char[] ringingFile = null;
 
 boolean alarmSet = false;
 boolean timerSet = false;
@@ -237,6 +240,8 @@ public boolean isAlarmRinging() {
 public void stopAlarm() {
     semP(sem);
     alarmRinging = false;
+    if (ringingFile!=null) free(ringingFile);
+    ringingFile = null;
     semV(sem);
     MP3stop();
 }
@@ -371,6 +376,9 @@ public void clockMain(){
             if (MP3playfile(playFile, false)) {
                 if (playIsAlarm) {
                     semP(sem);
+                    if (ringingFile!=null) free(ringingFile);
+                    ringingFile = playFile;
+                    playFile = null;
                     alarmRinging = true;
                     semV(sem);
                 }
@@ -379,8 +387,17 @@ public void clockMain(){
                 dbgPutStr("alarm play failed\n");
 #endif
             }
-            free(playFile);
+            if (playFile!=null) free(playFile);
         }
+
+        // 停止処理と同じロックで判定から再生要求まで保護する．
+        // stopAlarmが先なら再生せず，後ならこの再生もMP3stopで停止する．
+        semP(sem);
+        if (alarmRinging && ringingFile!=null &&
+            getPlaybackState()==MP3_STATE_FINISHED) {
+            if (!MP3playfile(ringingFile, false)) dbgPutStr("C: replay failed\n");
+        }
+        semV(sem);
     }
 }
 
